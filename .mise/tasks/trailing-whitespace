#!/bin/sh

set -u

fix=0
if [ "$#" -gt 0 ] && [ "$1" = "--fix" ]; then
    fix=1
    shift
fi
if [ "$#" -gt 0 ] && [ "$1" = "--" ]; then
    shift
fi

cr=$(printf '\r')
status=0
tmp_file=

cleanup() {
    exit_status=$?
    trap - EXIT HUP INT QUIT TERM
    if [ -n "$tmp_file" ]; then
        rm -f "$tmp_file"
    fi
    exit "$exit_status"
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 131' QUIT
trap 'exit 143' TERM

file_mode() {
    stat_target=$1
    case "$stat_target" in
        -*) stat_target=./$stat_target;;
    esac
    if [ "$(uname -s)" = Darwin ]; then
        stat -f '%Lp' "$stat_target"
    else
        stat -c '%a' "$stat_target"
    fi
}

process_line() {
    original_body=$1
    original_eol=$2
    stripped_line=$(printf '%s\n' "$original_body" | sed 's/[[:space:]]*$//')
    processed_body=$stripped_line

    if [ "$markdown" = yes ] && [ -n "$stripped_line" ]; then
        case "$original_body" in
            *"  ") processed_body="$stripped_line  ";;
        esac
    fi

    processed_line="$processed_body$original_eol"
    original_line="$original_body$original_eol"
    if [ "$processed_line" != "$original_line" ]; then
        changed=1
    fi
}

process_file() {
    filename=$1

    if [ ! -f "$filename" ] || [ ! -r "$filename" ]; then
        printf '%s: cannot read file\n' "$filename" >&2
        return 1
    fi

    case "$filename" in
        */CHANGELOG.md|CHANGELOG.md) return 0;;
    esac

    if ! LC_ALL=C grep -Iq . -- "$filename" 2>/dev/null; then
        return 0
    fi

    case "$filename" in
        *.[mM][dD]) markdown=yes;;
        *) markdown=no;;
    esac

    changed=0
    if [ "$fix" -eq 1 ]; then
        file_dir=${filename%/*}
        if [ "$file_dir" = "$filename" ]; then
            file_dir=.
        fi
        tmp_file=$(mktemp "$file_dir/.trailing-whitespace.XXXXXX") || {
            printf '%s: cannot create temporary file\n' "$filename" >&2
            return 1
        }
    fi

    while :; do
        line=
        IFS= read -r line
        read_status=$?
        if [ "$read_status" -ne 0 ] && [ -z "$line" ]; then
            break
        fi

        eol=
        body=$line
        if [ "$read_status" -eq 0 ]; then
            case "$body" in
                *"$cr") eol=$cr; body=${body%?};;
            esac
        fi

        process_line "$body" "$eol"
        if [ "$fix" -eq 1 ]; then
            if ! printf '%s' "$processed_line" >> "$tmp_file"; then
                printf '%s: cannot write temporary file\n' "$filename" >&2
                rm -f "$tmp_file"
                tmp_file=
                return 1
            fi
            if [ "$read_status" -eq 0 ] && ! printf '\n' >> "$tmp_file"; then
                printf '%s: cannot write temporary file\n' "$filename" >&2
                rm -f "$tmp_file"
                tmp_file=
                return 1
            fi
        fi
    done < "$filename"

    if [ "$changed" -eq 1 ]; then
        if [ "$fix" -eq 1 ]; then
            if ! mode=$(file_mode "$filename"); then
                printf '%s: cannot read file mode\n' "$filename" >&2
                rm -f "$tmp_file"
                tmp_file=
                return 1
            fi
            if ! chmod "$mode" "$tmp_file"; then
                printf '%s: cannot preserve file mode\n' "$filename" >&2
                rm -f "$tmp_file"
                tmp_file=
                return 1
            fi
            replace_target=$filename
            case "$replace_target" in
                -*) replace_target=./$replace_target;;
            esac
            if mv -f "$tmp_file" "$replace_target"; then
                tmp_file=
                printf 'Fixing %s\n' "$filename"
            else
                printf '%s: cannot replace file\n' "$filename" >&2
                rm -f "$tmp_file"
                tmp_file=
                return 1
            fi
        else
            printf '%s\n' "$filename"
            status=1
        fi
    fi

    if [ "$fix" -eq 1 ] && [ -n "$tmp_file" ]; then
        rm -f "$tmp_file"
        tmp_file=
    fi
    return 0
}

for filename
do
    if ! process_file "$filename"; then
        status=1
    fi
done

exit "$status"
