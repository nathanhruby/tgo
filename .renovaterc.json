{
  "extends": ["config:best-practices"],
  "labels": ["dependencies", "renovatebot"],
  "packageRules": [
    {
      "description": "Group jdx updates and run them every other Wednesday",
      "groupName": "jdx",
      "matchPackageNames": ["jdx/**", "github.com/jdx/**", "hk"],
      "schedule": ["* * 8-14,22-28 * 3"],
      "automergeSchedule": ["* * 8-14,22-28 * 3"],
      "separateMajorMinor": false
    },
    {
      "automerge": true,
      "matchUpdateTypes": ["patch", "pin", "digest", "minor"]
    },
    {
      "matchUpdateTypes": ["major"],
      "reviewers": ["nathanhruby"]
    }
  ],
  "prConcurrentLimit": 10,
  "platformAutomerge": true,
  "automergeSchedule": ["every weekend"],
  "separateMinorPatch": true,
  "postUpdateOptions": ["gomodTidy"],
  "timezone": "America/Los_Angeles"
}
